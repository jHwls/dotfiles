[user]
name = Jack Howells
email = info@jhowells.com
signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIEdNVKR7EbuRa7A8vetoKUXD9uZMGabjX6UKhMRRRrb

# Sign commits with an SSH key. The signing key above lives in 1Password.
[gpg]
format = ssh

# macOS: hand signing to the 1Password desktop app (it holds the private key).
[gpg "ssh"]
program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# On headless Linux gpg.ssh.program is left unset: git falls back to
# `ssh-keygen`, which signs via the 1Password agent forwarded from my machine.
[commit]
gpgsign = true
verbose = true

[init]
defaultBranch = main

[push]
default = current

[color]
ui = auto

[merge]
ff = only
conflictStyle = zdiff3

[fetch]
prune = true

[rebase]
updateRefs = true
autosquash = true

[include]
path = ~/.gitconfig.local

[alias]
a = add
aa = add --all
ap = add --patch
ai = add -i
b = branch
c = commit
ci = commit -v
c = commit --amend --no-edit
co = switch --no-guess
cp = cherry-pick
cur = rev-parse --abbrev-ref HEAD
fo = fetch origin --prune
fp = push --force-with-lease
l = log --oneline
ls = branch --list --sort=-committerdate
new = switch -c
p = push
rb = rebase
rbi = rebase -i
s = status

[core]
editor = vim
pager = delta

[interactive]
diffFilter = delta --color-only

[delta]
navigate = true  # use n and N to move between diff sections
features = unobtrusive-line-numbers
syntax-theme = none
file-style = none
file-decoration-style = none
hunk-header-style = file line-number
hunk-header-decoration-style = none
hunk-header-file-style = none
hunk-header-line-number-style = none
zero-style = "#777777"
file-modified-label = "M"
file-added-label = "A"
file-removed-label = "D"
file-renamed-label = "R"
hunk-label = "@@"

[delta "unobtrusive-line-numbers"]
line-numbers = true
line-numbers-zero-style = "#444444"
line-numbers-left-format = "{nm:>4}"
line-numbers-right-format = "{np:>4}  "
