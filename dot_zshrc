# ~/.zshrc — rendered by chezmoi from .chezmoidata/sh.yaml.

# PATH
typeset -U path PATH
path=('/Users/jhwls/.local/bin' '/Users/jhwls/.cargo/bin' /opt/homebrew/bin /opt/homebrew/sbin $path)

# mise: manage runtime versions.
eval "$(mise activate zsh)"

# Environment
export BAT_THEME='base16'
export EDITOR='zed'

# Aliases
[ -f ~/.config/zsh/aliases.zsh ] && source ~/.config/zsh/aliases.zsh

# carapace: multi-shell completions (git etc.). Needs compinit + bashcompinit first.
autoload -Uz +X compinit && compinit
autoload -Uz +X bashcompinit && bashcompinit
source <(carapace _carapace)

# Starship prompt.
eval "$(starship init zsh)"

# pnpm
export PNPM_HOME="/Users/jhwls/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
