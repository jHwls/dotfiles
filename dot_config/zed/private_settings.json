// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	"collaboration_panel": {
		"button": false
	},
	"zoomed_padding": false,
	"active_pane_modifiers": {
		"inactive_opacity": 0.6,
		"border_size": 0.0
	},
	"tab_bar": {
		"show_tab_bar_buttons": false,
		"show_nav_history_buttons": false
	},
	"context_servers": {
		"hub": {
			"enabled": true,
			"url": "http://localhost:3774/mcp"
		}
	},
	"language_models": {
		"openai_compatible": {
			"GreenPT": {
				"api_url": "https://api.greenpt.ai/v1",
				"available_models": [
					{
						"name": "glm-5.3",
						"max_tokens": 1000000,
						"max_output_tokens": 131072,
						"reasoning_effort": "medium",
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": true,
							"prompt_cache_key": true,
							"chat_completions": true,
							"interleaved_reasoning": true,
							"max_tokens_parameter": true
						}
					},
					{
						"name": "glm-5.3-flash",
						"max_tokens": 1000000,
						"max_output_tokens": 131072,
						"reasoning_effort": "medium",
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": true,
							"prompt_cache_key": true,
							"chat_completions": true,
							"interleaved_reasoning": true,
							"max_tokens_parameter": true
						}
					},
					{
						"name": "glm-5.2-honey-ultra",
						"max_tokens": 1000000,
						"max_output_tokens": 131072,
						"reasoning_effort": "medium",
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": true,
							"prompt_cache_key": true,
							"chat_completions": true,
							"interleaved_reasoning": true,
							"max_tokens_parameter": true
						}
					},
					{
						"name": "kimi-k3",
						"max_tokens": 1000000,
						"max_output_tokens": 131072,
						"reasoning_effort": "high",
						"capabilities": {
							"tools": true,
							"images": true,
							"parallel_tool_calls": true,
							"prompt_cache_key": true,
							"chat_completions": true,
							"interleaved_reasoning": true,
							"max_tokens_parameter": true
						}
					},
					{
						"name": "kimi-k2.7-code",
						"max_tokens": 256000,
						"max_output_tokens": 8192,
						"reasoning_effort": "medium",
						"capabilities": {
							"tools": true,
							"images": true,
							"parallel_tool_calls": true,
							"prompt_cache_key": true,
							"chat_completions": true,
							"interleaved_reasoning": false,
							"max_tokens_parameter": true
						}
					},
					{
						"name": "green-r",
						"max_tokens": 128000,
						"max_output_tokens": 32000,
						"reasoning_effort": "medium",
						"capabilities": {
							"tools": true,
							"images": true,
							"parallel_tool_calls": true,
							"prompt_cache_key": true,
							"chat_completions": true,
							"interleaved_reasoning": false,
							"max_tokens_parameter": true
						}
					}
				]
			}
		}
	},
	"markdown_preview": {
		"font_family": ".ZedSans",
		"font_size": 20.0,
		"max_width": 1000.0
	},
	"git_panel": {
		"dock": "left",
		"group_by": "staging",
		"tree_view": false
	},
	"outline_panel": {
		"button": false,
		"dock": "right"
	},
	"git": {
		"inline_blame": {
			"delay_ms": 100
		},
		"path_style": "file_path_first",
		"blame": {
			"show_avatar": true
		},
		"gutter_debounce": 10
	},
	"bottom_dock_layout": "full",
	"tabs": {
		"file_icons": false,
		"git_status": true
	},
	"title_bar": {
		"show_project_items": true,
		"show_branch_status_icon": true,
		"show_menus": false,
		"show_user_picture": false,
		"show_user_menu": true,
		"show_sign_in": false
	},
	"search": {
		"button": false
	},
	"status_bar": {
		"cursor_position_button": true
	},
	"agent_buffer_font_size": 16.0,
	"agent_ui_font_size": 18.0,
	"show_edit_predictions": false,
	"agent": {
		"tool_permissions": {
			"tools": {
				"mcp:hub:listToolFiles": {
					"default": "allow"
				},
				"mcp:hub:getToolDocs": {
					"default": "allow"
				},
				"mcp:hub:executeToolCode": {
					"default": "allow"
				},
				"mcp:hub:readToolFile": {
					"default": "allow"
				}
			}
		},
		"button": false,
		"sandbox_permissions": {
			"network_hosts": ["github.com", "hex.pm", "hexdocs.pm"],
			"warn_ntfs_grants": true
		},
		"show_turn_stats": true,
		"default_model": {
			"provider": "GreenPT",
			"model": "glm-5.3-flash",
			"enable_thinking": true,
			"effort": "medium"
		},
		"profiles": {
			"build": {
				"name": "Build",
				"tools": {
					"copy_path": true,
					"create_directory": true,
					"create_thread": true,
					"delete_path": true,
					"diagnostics": true,
					"apply_code_action": true,
					"edit_file": true,
					"write_file": true,
					"fetch": true,
					"find_path": true,
					"find_references": true,
					"get_code_actions": true,
					"go_to_definition": true,
					"list_agents_and_models": true,
					"list_directory": true,
					"move_path": true,
					"rename_symbol": true,
					"read_file": true,
					"grep": true,
					"skill": true,
					"spawn_agent": true,
					"terminal": true,
					"search_web": true
				},
				"enable_all_context_servers": true,
				"context_servers": {
					"daisy": {
						"tools": {
							"convert_bootstrap_to_daisyui": false
						}
					}
				}
			},
			"design": {
				"default_model": {
					"provider": "GreenPT",
					"model": "glm-5.2-honey-ultra",
					"enable_thinking": true,
					"effort": "medium"
				},
				"name": "Design",
				"tools": {
					"create_thread": true,
					"diagnostics": true,
					"fetch": true,
					"list_agents_and_models": true,
					"list_directory": true,
					"find_path": true,
					"find_references": true,
					"get_code_actions": true,
					"go_to_definition": true,
					"read_file": true,
					"grep": true,
					"skill": true,
					"spawn_agent": true,
					"search_web": true
				},
				"enable_all_context_servers": false,
				"context_servers": {
					"daisy": {
						"tools": {
							"daisyui_setup_expert": true,
							"daisyui_rules_enforcer": true,
							"daisyui_quality_inspector": true,
							"daisyui_page_architect": true,
							"daisyui_creative_director": true,
							"daisyui_component_syntax_expert": true,
							"convert_tailwind_to_daisyui": true,
							"convert_screenshot_to_daisyui": true,
							"convert_picture_to_theme": true,
							"convert_figma_to_daisyui": true
						}
					},
					"linear": {
						"tools": {
							"save_document": true,
							"save_status_update": true,
							"save_project": true,
							"save_issue": true,
							"save_comment": true,
							"search_documentation": false,
							"list_users": true,
							"list_teams": true,
							"list_releases": true,
							"list_release_pipelines": true,
							"list_release_notes": true,
							"list_projects": true,
							"list_project_labels": true,
							"list_milestones": true,
							"list_issues": true,
							"list_issue_statuses": true,
							"list_issue_labels": true,
							"list_initiatives": true,
							"list_initiative_labels": true,
							"list_documents": true,
							"list_diffs": true,
							"list_cycles": true,
							"list_customers": true,
							"get_agent_skill": false,
							"list_comments": true,
							"list_agent_skills": false,
							"get_workspace": true,
							"get_user": true,
							"get_team": true,
							"get_status_updates": true,
							"get_release_note": true,
							"get_release": true,
							"get_project": true,
							"get_milestone": true,
							"get_issue_status": true,
							"get_issue": true,
							"get_initiative": true,
							"get_document": true,
							"get_attachment": true,
							"create_attachment": false
						}
					}
				}
			},
			"ask": {
				"name": "Ask",
				"tools": {
					"create_thread": true,
					"diagnostics": true,
					"fetch": true,
					"list_agents_and_models": true,
					"list_directory": true,
					"find_path": true,
					"find_references": true,
					"get_code_actions": true,
					"go_to_definition": true,
					"read_file": true,
					"grep": true,
					"skill": true,
					"spawn_agent": true,
					"search_web": true
				},
				"enable_all_context_servers": false,
				"context_servers": {
					"linear": {
						"tools": {
							"search_documentation": false,
							"list_users": true,
							"list_teams": true,
							"list_releases": true,
							"list_release_pipelines": true,
							"list_release_notes": true,
							"list_projects": true,
							"list_project_labels": true,
							"list_milestones": true,
							"list_issues": true,
							"list_issue_statuses": true,
							"list_issue_labels": true,
							"list_initiatives": true,
							"list_initiative_labels": true,
							"list_documents": true,
							"list_diffs": true,
							"list_cycles": true,
							"list_customers": true,
							"get_agent_skill": false,
							"list_comments": true,
							"list_agent_skills": false,
							"get_workspace": true,
							"get_user": true,
							"get_team": true,
							"get_status_updates": true,
							"get_release_note": true,
							"get_release": true,
							"get_project": true,
							"get_milestone": true,
							"get_issue_status": true,
							"get_issue": true,
							"get_initiative": true,
							"get_document": true,
							"get_attachment": true,
							"create_attachment": false
