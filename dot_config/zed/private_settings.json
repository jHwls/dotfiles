		},
		"default_profile": "build",
		"max_content_width": 960.0,
		"default_width": 640.0,
		"sidebar_side": "left",
		"dock": "left",
		"flexible": true,
		"terminal_init_command": "claude",
		"thinking_display": "always_collapsed",
		"play_sound_when_agent_done": "never",
		"notify_when_agent_waiting": "never",
		"auto_compact": {
			"enabled": false
		},
		"use_modifier_to_send": true,
		"expand_terminal_card": false,
		"favorite_models": [],
		"model_parameters": [],
		"enable_feedback": false
	},
	"edit_predictions": {
		"allow_data_collection": "no",
		"provider": "none"
	},
	"diff_view_style": "unified",
	"agent_servers": {
		"opencode": {
			"type": "registry"
		},
		"goose": {
			"type": "registry"
		},
		"claude-acp": {
			"favorite_config_option_values": {
				"mode": ["default", "plan", "acceptEdits"]
			},
			"default_config_options": {
				"effort": "medium",
				"fast": false,
				"mode": "acceptEdits"
			},
			"type": "registry"
		}
	},
	"cli_default_open_behavior": "existing_window",
	"icon_theme": {
		"mode": "system",
		"light": "Zed (Default)",
		"dark": "Zed (Default)"
	},
	"base_keymap": "Atom",
	"vim_mode": true,
	"vim": {
		// "never" = system clipboard only with an explicit "+ / "* register
		"use_system_clipboard": "never"
	},
	"theme": {
		"mode": "system",
		"light": "Xcode High Contrast Light",
		"dark": "Xcode High Contrast Darker"
	},
	"ui_font_size": 16,
	"buffer_font_size": 16,
	"hard_tabs": true,
	"project_panel": {
		"hide_root": true,
		"git_status_indicator": true,
		"scrollbar": {
			"horizontal_scroll": true
		},
		"bold_folder_labels": false,
		"entry_spacing": "standard",
		"dock": "right"
	},
	"terminal": {
		"show_count_badge": false,
		"dock": "bottom",
		"flexible": true,
		"toolbar": {
			"breadcrumbs": false
		}
	},
	// Declarative extension install list. Zed installs anything missing on
	// launch; removing an entry does NOT uninstall — do that via the
	// extensions panel.
	"auto_install_extensions": {
		"astro": true,
		"biome": true,
		"docker-compose": true,
		"dockerfile": true,
		"elixir": true,
		"erlang": true,
		"git-firefly": true,
		"html": true,
		"log": true,
		"make": true,
		"mermaid": true,
		"nu": true,
		"opentofu": true,
		"oxc": true,
		"php": true,
		"ruby": true,
		"scss": true,
		"sql": true,
		"svelte": true,
		"swift": true,
		"toml": true,
		"wc-language-server": true,
		"xcode-themes": true,
		"xml": true
	},
	// Highlight WebC (.webc) as HTML — it's an HTML superset.
	"file_types": {
		"HTML": ["webc"]
	},
	"languages": {
		"Elixir": {
			"language_servers": ["expert"]
		},
		// Biome extension is installed but disabled by default. Per-project
		// configs can opt back in with "language_servers": ["biome", "..."].
		"JavaScript": { "language_servers": ["!biome", "..."] },
		"TypeScript": { "language_servers": ["!biome", "..."] },
		"TSX": { "language_servers": ["!biome", "..."] },
		"Astro": { "language_servers": ["!biome", "..."] },
		"Svelte": { "language_servers": ["!biome", "..."] },
		"JSON": { "language_servers": ["!biome", "..."] },
		"JSONC": { "language_servers": ["!biome", "..."] },
		"CSS": { "language_servers": ["!biome", "..."] },
		"HTML": { "language_servers": ["!biome", "..."] }
	}
}
